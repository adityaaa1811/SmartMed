# Copy to .env for local Docker MySQL (database/docker-compose.yml)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smartmed
MYSQL_USER=smartmed
MYSQL_PASSWORD=smartmed
MYSQL_PORT=3306

# Backend
SMARTMED_SERVER_PORT=8080
SMARTMED_DB_URL=jdbc:mysql://localhost:3306/smartmed?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SMARTMED_DB_USERNAME=smartmed
SMARTMED_DB_PASSWORD=smartmed
SMARTMED_JPA_DDL=update
SMARTMED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 2 — required for backend startup (min 32 characters; use a long random value locally)
SMARTMED_JWT_SECRET=replace-with-local-dev-secret-at-least-32-chars
SMARTMED_JWT_EXPIRATION_MS=86400000

# Phase 6 — external drug interaction API (never commit real keys)
SMARTMED_INTERACTION_PROVIDER=mock
SMARTMED_INTERACTION_API_KEY=
