# Local Docker MySQL only. These are development examples, not deployable credentials.
MYSQL_ROOT_PASSWORD=local-dev-root-change-me
MYSQL_DATABASE=smartmed
MYSQL_USER=smartmed
MYSQL_PASSWORD=local-dev-db-change-me
MYSQL_PORT=3306

# Local backend development; Railway environment variables are documented in README.
PORT=8080
SMARTMED_DB_URL=jdbc:mysql://localhost:3306/smartmed?serverTimezone=UTC&sslMode=DISABLED
SMARTMED_DB_USERNAME=smartmed
SMARTMED_DB_PASSWORD=local-dev-db-change-me
SMARTMED_DB_SSL_MODE=DISABLED
SMARTMED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMARTMED_TIMEZONE=Asia/Kolkata

# Generate and export a fresh value locally before starting the backend.
# Production requires base64: followed by at least 32 random bytes.
SMARTMED_JWT_SECRET=
SMARTMED_JWT_EXPIRATION_MS=86400000
SMARTMED_LOGIN_FAILURE_LIMIT=10
SMARTMED_REGISTRATION_LIMIT=8
SMARTMED_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
SMARTMED_AUTH_RATE_LIMIT_MAX_KEYS=10000
SMARTMED_JPA_DDL=validate
SMARTMED_FLYWAY_ENABLED=true

# Phase 6 — external drug interaction API (never commit real keys)
SMARTMED_INTERACTION_PROVIDER=mock
SMARTMED_INTERACTION_API_KEY=

# Frontend: blank means local Vite /api proxy.
VITE_API_BASE_URL=
VITE_SMARTMED_TIMEZONE=Asia/Kolkata

# Production-only values belong in the deployment secret/configuration store.
# Set all database identity fields explicitly; Railway MYSQL* variables are accepted as fallbacks.
# SMARTMED_DB_HOST=
# SMARTMED_DB_PORT=3306
# SMARTMED_DB_NAME=
# SMARTMED_DB_USERNAME=
# SMARTMED_DB_PASSWORD=
# SMARTMED_DB_SSL_MODE=VERIFY_IDENTITY
# SMARTMED_DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# For an external MySQL CA, mount a truststore and set JAVA_TOOL_OPTIONS, for example:
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=file:/run/secrets/mysql-truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=<deployment-secret>
